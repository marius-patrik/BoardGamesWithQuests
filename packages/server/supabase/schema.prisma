  beforeDigest String? @map("before_digest")
  afterDigest String? @map("after_digest")
  game Game @relation("R_events_gameId_games", fields: [gameId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  actor Participant? @relation("R_events_gameId_actorId_participants", fields: [gameId, actorId], references: [gameId, id], onDelete: NoAction, onUpdate: NoAction)
