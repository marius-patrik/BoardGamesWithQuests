{
  "repo": {
    "$comment": "DarkFactory repository configuration. Documentation is deployed from GitHub Actions and has a project-specific docs UI.",
    "identity": {
      "owner": "marius-patrik",
      "repo": "BoardGamesWithQuests",
      "display_name": "BoardGamesWithQuests",
      "project_title": "BoardGamesWithQuests",
      "agent_slug": "boardgameswithquests-agent",
      "default_branch": "main",
      "description": "Configurable chess/checkers app with declarative JSON game rules, React frontend, and Python backend on Vercel.",
      "topics": [
        "chess",
        "checkers",
        "python",
        "typescript",
        "react",
        "game",
        "education"
      ],
      "development_branch": "main"
    },
    "upstream": {
      "repo": "marius-patrik/DarkFactory",
      "ref": "4726c2a686878a80b8ed982a74e54df598f1104c"
    },
    "versioning": {
      "mode": "pridever",
      "tag_prefix": "v",
      "initial": "0.1.0"
    },
    "environment": {
      "$comment": "Python and documentation actions. Python artifact publishing remains disabled until the behavior release gate.",
      "testing": {
        "python": {
          "command": "pytest",
          "versions": [
            "3.10",
            "3.11",
            "3.12",
            "3.13"
          ]
        }
      },
      "documentation": {
        "python": {
          "command": "python .github/scripts/build_docs.py",
          "source": "repository Markdown and Python docstrings"
        }
      },
      "release": {
        "python": {
          "enabled": false
        }
      }
    },
    "areas": {
      "$comment": "Logical ownership/triage areas; declarations do not claim that target functionality is complete.",
      "$default": "core",
      "rules": {
        "description": "JSON-declared generic rule hooks, validators and rule composition",
        "keywords": [
          "rule",
          "rules",
          "move",
          "check",
          "mate",
          "castling",
          "promotion",
          "stalemate",
          "legal"
        ]
      },
      "pieces": {
        "description": "Declarative pieces, movement/attack capabilities and symbols",
        "keywords": [
          "piece",
          "pieces",
          "bishop",
          "knight",
          "rook",
          "queen",
          "king",
          "pawn",
          "vector"
        ]
      },
      "quests": {
        "description": "JSON-declared quests, per-player state, rewards and completion",
        "keywords": [
          "quest",
          "quests",
          "objective",
          "reward",
          "progression",
          "challenge"
        ]
      },
      "board": {
        "description": "Game-neutral board, coordinates, variants and placements",
        "keywords": [
          "board",
          "square",
          "grid",
          "coordinate",
          "layout",
          "configuration"
        ]
      },
      "docs": {
        "description": "Documentation site, API reference, architecture notes",
        "keywords": [
          "doc",
          "docs",
          "documentation",
          "mkdocs",
          "mkdocstrings",
          "readme"
        ]
      },
      "ci": {
        "description": "GitHub Actions workflows, containers, runner scripts, repository automation",
        "keywords": [
          "ci",
          "action",
          "workflow",
          "pipeline",
          "docker",
          "runner",
          "automation"
        ]
      },
      "core": {
        "description": "Controller, model wiring, application lifecycle, configuration",
        "keywords": [
          "controller",
          "model",
          "mvc",
          "lifecycle",
          "config",
          "state",
          "engine"
        ]
      },
      "game": {
        "description": "Chess/checkers configuration JSON and game-owned export formats",
        "keywords": [
          "chess",
          "checkers",
          "draughts",
          "wcdf",
          "fen",
          "pgn",
          "game"
        ]
      },
      "server": {
        "description": "FastAPI, Supabase auth, transactional game persistence and Realtime",
        "keywords": [
          "server",
          "api",
          "fastapi",
          "supabase",
          "auth",
          "database",
          "realtime"
        ]
      },
      "web": {
        "description": "React/Rsbuild/TypeScript/Bun user interface and configuration forms",
        "keywords": [
          "react",
          "web",
          "typescript",
          "rsbuild",
          "bun",
          "frontend"
        ]
      },
      "desktop": {
        "description": "Tauri native wrapper for the hosted web UI",
        "keywords": [
          "tauri",
          "desktop",
          "webview",
          "native"
        ]
      }
    },
    "required_checks": [
      "quality",
      "verify-bound-issue"
    ],
    "board": {
      "global": "Global",
      "boards": [
        "Global",
        "BoardGamesWithQuests"
      ]
    },
    "pages": {
      "build_type": "workflow"
    },
    "documentation": {
      "projects": [
        {
          "name": "DarkFactory",
          "url": "https://marius-patrik.github.io/DarkFactory/"
        },
        {
          "name": "Omnis",
          "url": "https://marius-patrik.github.io/omnis/"
        },
        {
          "name": "BoardGamesWithQuests",
          "url": "https://marius-patrik.github.io/BoardGamesWithQuests/"
        }
      ]
    },
    "license": {
      "spdx": "GPL-3.0-only",
      "holder": "marius-patrik",
      "year": "2026"
    }
  },
  "docs": {
    "version": 1,
    "site": {
      "name": "BoardGamesWithQuests",
      "description": "JSON-driven chess and checkers Python engine and React application"
    },
    "home": "README.md"
  },
  "providers": {}
}
