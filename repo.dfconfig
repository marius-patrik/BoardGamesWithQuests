{
  "repo": {
    "$comment": "DarkFactory repository configuration. Documentation is built from actions with a local docs UI; legacy gh-pages is only optional preview staging.",
    "identity": {
      "owner": "marius-patrik",
      "repo": "BoardGamesWithQuests",
      "display_name": "BoardGamesWithQuests",
      "project_title": "BoardGamesWithQuests",
      "agent_slug": "boardgameswithquests-agent",
      "default_branch": "main",
      "description": "Configurable chess/checkers app with declarative JSON game rules, React frontend, and Python backend on Vercel.",
      "topics": [
        "chess",
        "python",
        "mvc",
        "game",
        "education"
      ],
      "development_branch": "main"
    },
    "upstream": {
      "repo": "marius-patrik/DarkFactory",
      "ref": "b5bdba739bf989f965af51c9efd88ee89617075c"
    },
    "versioning": {
      "mode": "pridever",
      "tag_prefix": "v",
      "initial": "0.1.0"
    },
    "environment": {
      "$comment": "A Python application. The API reference is generated from docstrings by mkdocstrings, which properdocs still loads: it aliases mkdocs.* imports and reads mkdocs.plugins entry points.",
      "testing": {
        "python": {
          "command": "pytest",
          "versions": [
            "3.10",
            "3.11",
            "3.12",
            "3.13"
          ]
        }
      },
      "documentation": {
        "python": {
          "command": "python .github/scripts/build_docs.py",
          "source": "repository Markdown and Python docstrings"
        }
      },
      "release": {
        "python": {
          "enabled": false
        }
      }
    },
    "areas": {
      "$comment": "ChessWithQuests's own domains. Declaration order is match order.",
      "$default": "core",
      "rules": {
        "description": "Move generation, check and mate detection, chess rule conformance",
        "keywords": [
          "rule",
          "rules",
          "move",
          "check",
          "mate",
          "castling",
          "promotion",
          "stalemate",
          "legal"
        ]
      },
      "pieces": {
        "description": "Piece definitions, movement and attack vectors, custom pieces",
        "keywords": [
          "piece",
          "pieces",
          "bishop",
          "knight",
          "rook",
          "queen",
          "king",
          "pawn",
          "vector"
        ]
      },
      "quests": {
        "description": "Quest system, objectives, progression and rewards",
        "keywords": [
          "quest",
          "quests",
          "objective",
          "reward",
          "progression",
          "challenge"
        ]
      },
      "board": {
        "description": "Board representation, custom board configurations, coordinates",
        "keywords": [
          "board",
          "square",
          "grid",
          "coordinate",
          "layout",
          "configuration"
        ]
      },
      "view": {
        "description": "Desktop UI, rendering, input handling",
        "keywords": [
          "view",
          "ui",
          "gui",
          "render",
          "window",
          "input",
          "display",
          "sprite"
        ]
      },
      "docs": {
        "description": "Documentation site, API reference, architecture notes",
        "keywords": [
          "doc",
          "docs",
          "documentation",
          "mkdocs",
          "mkdocstrings",
          "readme"
        ]
      },
      "ci": {
        "description": "GitHub Actions workflows, containers, runner scripts, repository automation",
        "keywords": [
          "ci",
          "action",
          "workflow",
          "pipeline",
          "docker",
          "runner",
          "automation"
        ]
      },
      "core": {
        "description": "Controller, model wiring, application lifecycle, configuration",
        "keywords": [
          "controller",
          "model",
          "mvc",
          "lifecycle",
          "config",
          "state",
          "engine"
        ]
      }
    },
    "required_checks": [
      "quality",
      "verify-bound-issue"
    ],
    "board": {
      "global_title": "Global",
      "link_boards": [
        "Global",
        "BoardGamesWithQuests"
      ]
    },
    "pages": {
      "build_type": "workflow"
    },
    "documentation": {
      "projects": [
        {
          "name": "DarkFactory",
          "url": "https://marius-patrik.github.io/DarkFactory/"
        },
        {
          "name": "Omnis",
          "url": "https://marius-patrik.github.io/omnis/"
        },
        {
          "name": "BoardGamesWithQuests",
          "url": "https://marius-patrik.github.io/BoardGamesWithQuests/"
        }
      ]
    },
    "license": {
      "spdx": "GPL-3.0-only",
      "holder": "marius-patrik",
      "year": "2026"
    }
  },
  "docs": {
    "version": 1,
    "site": {
      "name": "BoardGamesWithQuests",
      "description": "JSON-driven chess and checkers Python engine and React application"
    },
    "home": "README.md"
  },
  "providers": {}
}
