{
  "repo": {
    "$comment": "DarkFactory repository configuration. Documentation is deployed from GitHub Actions and has a project-specific docs UI.",
    "identity": {
      "owner": "marius-patrik",
      "repo": "BoardGamesWithQuests",
      "display_name": "BoardGamesWithQuests",
      "project_title": "BoardGamesWithQuests",
      "agent_slug": "boardgameswithquests-agent",
      "default_branch": "main",
      "description": "Python engine/controller with FastAPI empty-catalog bootstrap, React/Supabase Auth client shell and Tauri WebView source; no multiplayer gameplay or live database.",
      "topics": [
        "chess",
        "checkers",
        "python",
        "typescript",
        "react",
        "game",
        "education"
      ],
      "development_branch": "main"
    },
    "upstream": {
      "repo": "marius-patrik/DarkFactory",
      "ref": "fc5896c9ffbf9b1ac5762a271ec2b26ee0efafd4"
    },
    "versioning": {
      "mode": "pridever",
      "tag_prefix": "v",
      "initial": "0.1.0"
    },
    "environment": {
      "$comment": "Python and documentation actions. Python artifact publishing remains disabled until the behavior release gate.",
      "testing": {
        "python": {
          "command": "pytest",
          "versions": [
            "3.10",
            "3.11",
            "3.12",
            "3.13"
          ]
        }
      },
      "documentation": {
        "python": {
          "command": "python .github/scripts/build_docs.py",
          "source": "repository Markdown and Python docstrings"
        }
      },
      "release": {
        "python": {
          "enabled": false
        }
      }
    },
    "areas": {
      "$comment": "Logical ownership/triage areas; declarations do not claim that target functionality is complete.",
      "$default": "core",
      "rules": {
        "description": "JSON-declared generic rule hooks, validators and rule composition",
        "keywords": [
          "rule",
          "rules",
          "move",
          "check",
          "mate",
          "castling",
          "promotion",
          "stalemate",
          "legal"
        ]
      },
      "pieces": {
        "description": "Declarative pieces, movement/attack capabilities and symbols",
        "keywords": [
          "piece",
          "pieces",
          "bishop",
          "knight",
          "rook",
          "queen",
          "king",
          "pawn",
          "vector"
        ]
      },
      "quests": {
        "description": "JSON-declared quests, per-player state, rewards and completion",
        "keywords": [
          "quest",
          "quests",
          "objective",
          "reward",
          "progression",
          "challenge"
        ]
      },
      "board": {
        "description": "Game-neutral board, coordinates, variants and placements",
        "keywords": [
          "board",
          "square",
          "grid",
          "coordinate",
          "layout",
          "configuration"
        ]
      },
      "docs": {
        "description": "Documentation site, API reference, architecture notes",
        "keywords": [
          "doc",
          "docs",
          "documentation",
          "mkdocs",
          "mkdocstrings",
          "readme"
        ]
      },
      "ci": {
        "description": "GitHub Actions workflows, containers, runner scripts, repository automation",
        "keywords": [
          "ci",
          "action",
          "workflow",
          "pipeline",
          "docker",
          "runner",
          "automation"
        ]
      },
      "core": {
        "description": "Reusable Python game engine under the server package",
        "keywords": [
          "controller",
          "model",
          "mvc",
          "lifecycle",
          "config",
          "state",
          "engine"
        ]
      },
      "game": {
        "description": "Chess/checkers configuration JSON and game-owned export formats",
        "keywords": [
          "chess",
          "checkers",
          "draughts",
          "wcdf",
          "fen",
          "pgn",
          "game"
        ]
      },
      "server": {
        "description": "Python moved engine and minimal FastAPI empty catalog",
        "keywords": [
          "server",
          "api",
          "fastapi",
          "engine"
        ]
      },
      "web": {
        "description": "Browser authentication shell and empty game catalog",
        "keywords": [
          "web",
          "client",
          "react",
          "auth"
        ]
      },
      "native": {
        "description": "Tauri 2 hosted-web client and desktop/mobile release assets",
        "keywords": [
          "tauri",
          "native",
          "android",
          "ios",
          "macos",
          "linux",
          "windows",
          "bundle"
        ]
      },
      "desktop": {
        "description": "Tauri hosted-webview wrapper and packaging code",
        "keywords": [
          "native",
          "tauri",
          "android",
          "ios",
          "desktop"
        ]
      }
    },
    "board": {
      "global": "Global",
      "boards": [
        "Global",
        "BoardGamesWithQuests"
      ]
    },
    "pages": {
      "build_type": "workflow"
    },
    "documentation": {
      "projects": [
        {
          "name": "DarkFactory",
          "url": "https://marius-patrik.github.io/DarkFactory/"
        },
        {
          "name": "Omnis",
          "url": "https://marius-patrik.github.io/omnis/"
        },
        {
          "name": "BoardGamesWithQuests",
          "url": "https://marius-patrik.github.io/BoardGamesWithQuests/"
        }
      ]
    },
    "license": {
      "spdx": "GPL-3.0-only",
      "holder": "marius-patrik",
      "year": "2026"
    },
    "protection": {
      "lanes": [
        {
          "branch": "main",
          "required_checks": [
            "governed / released-df-quality",
            "governed / issue-binding / verify-bound-issue"
          ],
          "approvals": 1,
          "strict": true,
          "enforce_admins": false,
          "resolve_conversations": true
        }
      ]
    }
  },
  "docs": {
    "version": 1,
    "site": {
      "name": "BoardGamesWithQuests",
      "description": "FastAPI server, reusable board-game engine, React web, Tauri native shell"
    },
    "home": "README.md"
  },
  "providers": {}
}
