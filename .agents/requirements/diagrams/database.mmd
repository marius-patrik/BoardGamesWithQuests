        boolean after_bool
        Bigbigint after_int
        numeric after_decimal
        varchar after_text
        timestamptz after_instant
        varchar after_ref
    }
    awards {
        varchar game_id PK
        varchar participant_id PK
        varchar objective_entity_id PK
        varchar event_id FK
        Bigbigint points
    }
    ratings {
        varchar user_id PK
        varchar definition_id PK
        bigint rating
        bigint games
        bigint wins
        bigint draws
        bigint losses
    }
    game_outcomes {
        varchar game_id PK
        varchar participant_id PK
        varchar event_id FK
        OutcomeKind kind
        Bigbigint score
    }
