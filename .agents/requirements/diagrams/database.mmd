erDiagram
%% Target PostgreSQL relational schema reference; not an applied migration.
%% Derived from the reviewed Prisma design. The actual PSL and versioned SQL migrations belong to implementation PR #271.
    auth_users {
        uuid id PK
    }
    profiles {
        uuid user_id PK
        varchar display_name
        varchar username UK
        timestamptz created_at
    }
    definitions {
        uuid id PK
        uuid owner_id
        varchar key
        varchar name
        varchar description
        boolean built_in
        timestamptz created_at
    }
    versions {
        uuid id PK
        uuid definition_id FK
        int number UK
        int minimum_participants
        int maximum_participants
        int semantics_version
        timestamptz published_at
        timestamptz created_at
    }
    roles {
        uuid id PK
        uuid version_id FK
        varchar key UK
        varchar label
        int forward_row
        int minimum_count
        int maximum_count
    }
    phases {
        uuid id PK
        uuid version_id FK
        varchar key UK
        varchar label
        boolean initial
        int ordinal
    }
    entity_types {
        uuid id PK
        uuid version_id FK
        varchar key UK
        varchar name
        EntityKind kind
    }
    entity_seeds {
        uuid id PK
        uuid version_id FK
        varchar key UK
        uuid entity_type_id FK
        int owner_seat
        uuid parent_id FK
        uuid location_id FK
        int ordinal
        int row
        int column
        numeric x
        numeric y
    }
    seed_links {
        uuid id PK
        uuid version_id FK
        uuid source_id FK
        uuid target_id FK
        varchar relation UK
        int ordinal
    }
    fields {
        uuid id PK
        uuid version_id FK
        uuid entity_type_id FK
        varchar key UK
        varchar type_key
        boolean nullable
    }
    seed_values {
        uuid seed_id PK
        uuid version_id FK
        uuid field_id PK
        ValueKind kind
        boolean bool_value
        bigint int_value
        numeric decimal_value
        varchar text_value
        timestamptz instant_value
        uuid ref_seed_id FK
        int ref_seat
    }
    operators {
        varchar key PK
        varchar kind
        varchar returns
        varchar summary
    }
    operator_parameters {
        varchar operator_key PK
        varchar key PK
        varchar type_key
        int ordinal UK
        boolean required
        boolean variadic
    }
    hooks {
        varchar key PK
        int ordinal UK
        varchar summary
    }
    expressions {
        uuid id PK
        uuid version_id FK
        varchar key UK
        varchar kind
        varchar result_type
        ValueKind literal_kind
        boolean literal_bool
        bigint literal_int
        numeric literal_decimal
        varchar literal_text
        timestamptz literal_instant
        varchar reference_key
        uuid field_id FK
        varchar operator_key FK
    }
    expression_arguments {
        uuid version_id FK
        uuid parent_id PK
        uuid child_id FK
        varchar parameter PK
        int ordinal PK
    }
    actions {
        uuid id PK
        uuid version_id FK
        uuid entity_type_id FK
        varchar key UK
        varchar title
        TriggerKind trigger
        varchar hook_key FK
        uuid iterator_expression_id FK
        varchar iterator_var
        uuid condition_expression_id FK
        int priority
        boolean enabled
    }
    action_parameters {
        uuid version_id FK
        uuid action_id PK
        varchar key PK
        varchar type_key
        boolean required
        int ordinal
    }
    phase_actions {
        uuid version_id FK
        uuid phase_id PK
        uuid action_id PK
    }
    effects {
        uuid id PK
        uuid version_id FK
        uuid action_id FK
        int ordinal UK
        varchar operator_key FK
        uuid condition_expression_id FK
    }
    effect_arguments {
        uuid version_id FK
        uuid effect_id PK
        uuid expression_id FK
        varchar key PK
        int ordinal PK
    }
    assets {
        uuid id PK
        uuid version_id FK
        varchar key UK
        varchar bucket UK
        varchar path UK
        varchar mime
        bigint bytes
        varchar sha256
        AssetStatus status
    }
    visual_templates {
        uuid id PK
        uuid version_id FK
        uuid entity_type_id FK
        varchar key UK
    }
    visual_primitives {
        uuid id PK
        uuid version_id FK
        uuid template_id FK
        varchar kind
        int layer UK
        int ordinal UK
        numeric x
        numeric y
        numeric width
        numeric height
        varchar path_data
        varchar text_content
        varchar fill
        varchar stroke
        uuid asset_id FK
    }
    games {
        uuid id PK
        uuid version_id FK
        uuid creator_id UK
        varchar creation_key UK
        int target_participants
        GameStatus status
        bigint revision
        uuid phase_id FK
        bigint turn
        timestamptz created_at
        timestamptz started_at
        timestamptz finished_at
        timestamptz expires_at
    }
    participants {
        uuid id PK
        uuid game_id FK
        uuid version_id FK
        uuid user_id UK
        uuid role_id FK
        int seat UK
        timestamptz eliminated_at
        timestamptz created_at
    }
    active_participants {
        uuid game_id PK
        uuid participant_id PK
    }
    game_entities {
        uuid id PK
        uuid game_id FK
        uuid version_id FK
        uuid entity_type_id FK
        uuid seed_id FK
        uuid owner_id FK
        uuid parent_id FK
        uuid location_id FK
        int ordinal
        bigint created_revision
        bigint removed_revision
    }
    game_links {
        uuid id PK
        uuid game_id FK
        uuid source_id FK
        uuid target_id FK
        varchar relation UK
        int ordinal
    }
    game_values {
        uuid game_id FK
        uuid version_id FK
        uuid entity_id PK
        uuid field_id PK
        ValueKind kind
        boolean bool_value
        bigint int_value
        numeric decimal_value
        varchar text_value
        timestamptz instant_value
        uuid ref_entity_id FK
        uuid ref_participant_id FK
        bigint updated_revision
    }
    game_composites {
        uuid id PK
        uuid game_id FK
        uuid version_id FK
        uuid owner_entity_id FK
        uuid field_id FK
        varchar container_kind
        varchar type_key
        bigint created_revision
    }
    game_composite_entries {
        uuid id PK
        uuid game_id FK
        uuid composite_id FK
        int ordinal UK
        varchar member_key UK
        ValueKind kind
        boolean bool_value
        bigint int_value
        numeric decimal_value
        varchar text_value
        timestamptz instant_value
        uuid ref_entity_id FK
        uuid ref_participant_id FK
        uuid child_composite_id FK
    }
    clocks {
        uuid game_id PK
        uuid participant_id PK
        bigint remaining_ms
        bigint increment_ms
        timestamptz anchor_at
        boolean paused
    }
    events {
        uuid id PK
        uuid game_id FK
        bigint revision UK
        uuid actor_id FK
        varchar action_key
        varchar request_id UK
        varchar request_digest
        int semantics_version
        timestamptz occurred_at
        varchar before_digest
        varchar after_digest
    }
    event_values {
        uuid id PK
        uuid game_id FK
        uuid event_id FK
        varchar category UK
        varchar key UK
        int ordinal UK
        ValueKind kind
        boolean bool_value
        bigint int_value
        numeric decimal_value
        varchar text_value
        timestamptz instant_value
        uuid entity_id FK
        uuid participant_id FK
    }
    event_mutations {
        uuid id PK
        uuid game_id FK
        uuid event_id FK
        int ordinal UK
        varchar target_kind
        uuid target_id
        varchar column_key
        OperationKind operation
        ValueKind before_kind
        boolean before_bool
        bigint before_int
        numeric before_decimal
        varchar before_text
        timestamptz before_instant
        uuid before_ref
        ValueKind after_kind
        boolean after_bool
        bigint after_int
        numeric after_decimal
        varchar after_text
        timestamptz after_instant
        uuid after_ref
    }
    awards {
        uuid game_id PK
        uuid participant_id PK
        uuid objective_entity_id PK
        uuid event_id FK
        bigint points
    }
    ratings {
        uuid user_id PK
        uuid definition_id PK
        int rating
        int games
        int wins
        int draws
        int losses
    }
    game_outcomes {
        uuid game_id PK
        uuid participant_id PK
        uuid event_id FK
        OutcomeKind kind
        bigint score
    }
