        numeric decimal_value
        varchar text_value
        timestamptz instant_value
        varchar entity_id FK
        varchar participant_id FK
    }
    event_mutations {
        varchar id PK
        varchar game_id FK
        varchar event_id FK
        bigint ordinal UK
        varchar target_kind
        varchar target_id
