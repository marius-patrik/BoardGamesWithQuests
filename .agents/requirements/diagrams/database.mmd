        numeric literal_decimal
        varchar literal_text
        timestamptz literal_instant
        varchar reference_key
        varchar field_id FK
        varchar operator_key FK
    }
    expression_arguments {
        varchar version_id FK
        varchar parent_id PK
        varchar child_id FK
        varchar parameter PK
        bigint ordinal PK
    }
    actions {
        varchar id PK
        varchar version_id FK
        varchar entity_type_id FK
        varchar key UK
        varchar title
        TriggerKind trigger
        varchar hook_key FK
        varchar iterator_expression_id FK
        varchar iterator_var
        varchar condition_expression_id FK
        bigint priority
        boolean enabled
    }
    action_parameters {
        varchar version_id FK
        varchar action_id PK
        varchar key PK
        varchar type_key
        boolean required
        bigint ordinal
    }
    phase_actions {
        varchar version_id FK
        varchar phase_id PK
        varchar action_id PK
    }
    effects {
        varchar id PK
        varchar version_id FK
        varchar action_id FK
        bigint ordinal UK
        varchar operator_key FK
        varchar condition_expression_id FK
    }
    effect_arguments {
        varchar version_id FK
        varchar effect_id PK
        varchar expression_id FK
        varchar key PK
        bigint ordinal PK
    }
    assets {
        varchar id PK
        varchar version_id FK
        varchar key UK
        varchar bucket UK
        varchar path UK
        varchar mime
        Bigbigint bytes
        varchar sha256
        AssetStatus status
    }
    visual_templates {
        varchar id PK
        varchar version_id FK
        varchar entity_type_id FK
        varchar key UK
    }
    visual_primitives {
        varchar id PK
        varchar version_id FK
        varchar template_id FK
        varchar kind
