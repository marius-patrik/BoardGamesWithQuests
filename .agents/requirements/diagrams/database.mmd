%% Target PostgreSQL relational schema reference; not an applied migration.
%% Derived from the reviewed Prisma design. The actual PSL and versioned SQL migrations belong to implementation PR #271.
    auth_users {
        uuid id PK
    }
    profiles {
        varchar user_id PK
        varchar display_name
        varchar username UK
        timestamptz created_at
    }
    definitions {
        varchar id PK
        varchar owner_id
        varchar key
        varchar name
        varchar description
        boolean built_in
        timestamptz created_at
    }
    versions {
        varchar id PK
        varchar definition_id FK
        bigint number UK
        bigint minimum_participants
        bigint maximum_participants
        bigint semantics_version
        timestamptz published_at
        timestamptz created_at
    }
    roles {
        varchar id PK
        varchar version_id FK
        varchar key UK
        varchar label
        bigint forward_row
        bigint minimum_count
        bigint maximum_count
    }
    phases {
        varchar id PK
        varchar version_id FK
        varchar key UK
        varchar label
        boolean initial
        bigint ordinal
    }
    entity_types {
        varchar id PK
        varchar version_id FK
        varchar key UK
        varchar name
        EntityKind kind
    }
    entity_seeds {
        varchar id PK
        varchar version_id FK
        varchar key UK
        varchar entity_type_id FK
        bigint owner_seat
        varchar parent_id FK
        varchar location_id FK
        bigint ordinal
        bigint row
        bigint column
        numeric x
        numeric y
    }
    seed_links {
        varchar id PK
        varchar version_id FK
        varchar source_id FK
        varchar target_id FK
        varchar relation UK
        bigint ordinal
    }
    fields {
        varchar id PK
        varchar version_id FK
        varchar entity_type_id FK
        varchar key UK
        varchar type_key
        boolean nullable
    }
    seed_values {
        varchar seed_id PK
        varchar version_id FK
        varchar field_id PK
        ValueKind kind
        boolean bool_value
        Bigbigint int_value
        numeric decimal_value
        varchar text_value
        timestamptz instant_value
        varchar ref_seed_id FK
        bigint ref_seat
    }
    operators {
        varchar key PK
        varchar kind
        varchar returns
        varchar summary
    }
    operator_parameters {
        varchar operator_key PK
        varchar key PK
        varchar type_key
        bigint ordinal UK
        boolean required
        boolean variadic
    }
    hooks {
        varchar key PK
        bigint ordinal UK
        varchar summary
    }
    expressions {
        varchar id PK
        varchar version_id FK
        varchar key UK
        varchar kind
        varchar result_type
        ValueKind literal_kind
        boolean literal_bool
