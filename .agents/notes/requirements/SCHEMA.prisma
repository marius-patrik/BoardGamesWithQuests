// BoardGamesWithQuests — normative relational model.
// Auth identities are supplied by Supabase-managed auth.users; their external FKs and
// database-only security/constraints are declared in INTEGRITY.sql.
// Python/psycopg uses the database at runtime. Prisma is a schema/migration tool only.

generator client {
  provider = "prisma-client"
  output   = "../../../packages/database/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["bgwq"]
}

enum EntityKind {
  game
  space
  item
  objective

  @@map("entity_kind")
  @@schema("bgwq")
}

enum GameStatus {
  pending
  active
  finished
  expired

  @@map("game_status")
  @@schema("bgwq")
}

enum ValueKind {
  bool
  int
  decimal
  text
  instant
  entity
  participant
  none

  @@map("value_kind")
  @@schema("bgwq")
}

enum TriggerKind {
  command
  hook

  @@map("trigger_kind")
  @@schema("bgwq")
}

enum OperationKind {
  insert
  set
  remove

  @@map("operation_kind")
  @@schema("bgwq")
}

enum AssetStatus {
  staged
  ready

  @@map("asset_status")
  @@schema("bgwq")
}

/// Display profile; auth.users is authoritative for identity.
model Profile {
  userId String @id @db.Uuid @map("user_id")
  displayName String @map("display_name")
  username String? @unique
  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  // Supabase auth.users is externally managed; database-level FK is in INTEGRITY.sql.

  @@map("profiles")
  @@schema("bgwq")
}

/// Published and user-owned game families.
model Definition {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId String? @db.Uuid @map("owner_id")
  key String
  name String
  description String?
  builtIn Boolean @default(false) @map("built_in")
  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  inverse_versions_definitionId Version[] @relation("R_versions_definitionId_definitions")
  inverse_ratings_definitionId Rating[] @relation("R_ratings_definitionId_definitions")

  // Partial uniqueIndex definition_owner_key (ownerId, key) WHERE ${t.ownerId} IS NOT NULL: INTEGRITY.sql
  // Partial uniqueIndex builtin_definition_key (key) WHERE ${t.builtIn}: INTEGRITY.sql
  // CHECK definition_builtin_ownership: implemented in INTEGRITY.sql; Prisma PSL cannot express CHECK.
  @@map("definitions")
  @@schema("bgwq")
}

/// Immutable after publication; version is pinned for the lifetime of a game.
model Version {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  definitionId String @db.Uuid @map("definition_id")
  number Int
  minimumParticipants Int @map("minimum_participants")
  maximumParticipants Int @map("maximum_participants")
  semanticsVersion Int @default(1) @map("semantics_version")
  publishedAt DateTime? @db.Timestamptz(6) @map("published_at")
  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  rel_definitions_definitionId Definition @relation("R_versions_definitionId_definitions", fields: [definitionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  inverse_roles_versionId Role[] @relation("R_roles_versionId_versions")
  inverse_phases_versionId Phase[] @relation("R_phases_versionId_versions")
  inverse_entityTypes_versionId EntityType[] @relation("R_entityTypes_versionId_versions")
  inverse_expressions_versionId Expression[] @relation("R_expressions_versionId_versions")
  inverse_assets_versionId Asset[] @relation("R_assets_versionId_versions")
  inverse_games_versionId Game[] @relation("R_games_versionId_versions")

  @@unique([definitionId, number], map: "version_number_unique")
  // CHECK version_bounds: implemented in INTEGRITY.sql; Prisma PSL cannot express CHECK.
  @@map("versions")
  @@schema("bgwq")
}

/// Player roles, independent of fixed chess sides.
model Role {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  versionId String @db.Uuid @map("version_id")
  key String
  label String
  forwardRow Int? @map("forward_row")
  minimumCount Int @default(0) @map("minimum_count")
  maximumCount Int @default(1) @map("maximum_count")
  rel_versions_versionId Version @relation("R_roles_versionId_versions", fields: [versionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  inverse_participants_versionId_roleId Participant[] @relation("R_participants_versionId_roleId_roles")

  @@unique([versionId, key], map: "role_version_key")
  @@unique([versionId, id], map: "role_version_id")
  // CHECK role_count: implemented in INTEGRITY.sql; Prisma PSL cannot express CHECK.
  // CHECK role_forward_row: implemented in INTEGRITY.sql; Prisma PSL cannot express CHECK.
  @@map("roles")
  @@schema("bgwq")
}

/// Turn/decision phase; transitions are configured actions.
model Phase {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  versionId String @db.Uuid @map("version_id")
  key String
  label String
  initial Boolean @default(false)
  ordinal Int @default(0)
  rel_versions_versionId Version @relation("R_phases_versionId_versions", fields: [versionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  inverse_phaseActions_versionId_phaseId PhaseAction[] @relation("R_phaseActions_versionId_phaseId_phases")
  inverse_games_versionId_phaseId Game[] @relation("R_games_versionId_phaseId_phases")

  @@unique([versionId, key], map: "phase_version_key")
  @@unique([versionId, id], map: "phase_version_id")
  // Partial uniqueIndex phase_single_initial (versionId) WHERE ${t.initial}: INTEGRITY.sql
  @@map("phases")
  @@schema("bgwq")
}

/// Types of entities: one of game, space, item, objective.
model EntityType {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  versionId String @db.Uuid @map("version_id")
  key String
  name String
  kind EntityKind
  rel_versions_versionId Version @relation("R_entityTypes_versionId_versions", fields: [versionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  inverse_entitySeeds_versionId_entityTypeId EntitySeed[] @relation("R_entitySeeds_versionId_entityTypeId_entityTypes")
  inverse_fields_versionId_entityTypeId Field[] @relation("R_fields_versionId_entityTypeId_entityTypes")
  inverse_actions_versionId_entityTypeId Action[] @relation("R_actions_versionId_entityTypeId_entityTypes")
  inverse_visualTemplates_versionId_entityTypeId VisualTemplate[] @relation("R_visualTemplates_versionId_entityTypeId_entityTypes")
  inverse_gameEntities_versionId_entityTypeId GameEntity[] @relation("R_gameEntities_versionId_entityTypeId_entityTypes")

  @@unique([versionId, key], map: "entity_type_key")
  @@unique([versionId, id], map: "entity_type_version_id")
  @@map("entity_types")
  @@schema("bgwq")
}

/// Topology and game placement are entity-to-entity relationships, not a fixed grid.
model EntitySeed {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  versionId String @db.Uuid @map("version_id")
  key String
  entityTypeId String @db.Uuid @map("entity_type_id")
  ownerSeat Int? @map("owner_seat")
  parentId String? @db.Uuid @map("parent_id")
  locationId String? @db.Uuid @map("location_id")
  ordinal Int?
  row Int?
  column Int?
  x Decimal? @db.Decimal(65, 30)
  y Decimal? @db.Decimal(65, 30)
  rel_entityTypes_versionId_entityTypeId EntityType @relation("R_entitySeeds_versionId_entityTypeId_entityTypes", fields: [versionId, entityTypeId], references: [versionId, id], onDelete: NoAction, onUpdate: NoAction)
  rel_entitySeeds_versionId_parentId EntitySeed? @relation("R_entitySeeds_versionId_parentId_entitySeeds", fields: [versionId, parentId], references: [versionId, id], onDelete: NoAction, onUpdate: NoAction)
  inverse_entitySeeds_versionId_parentId EntitySeed[] @relation("R_entitySeeds_versionId_parentId_entitySeeds")
  rel_entitySeeds_versionId_locationId EntitySeed? @relation("R_entitySeeds_versionId_locationId_entitySeeds", fields: [versionId, locationId], references: [versionId, id], onDelete: NoAction, onUpdate: NoAction)
  inverse_entitySeeds_versionId_locationId EntitySeed[] @relation("R_entitySeeds_versionId_locationId_entitySeeds")
  inverse_seedLinks_versionId_sourceId SeedLink[] @relation("R_seedLinks_versionId_sourceId_entitySeeds")
  inverse_seedLinks_versionId_targetId SeedLink[] @relation("R_seedLinks_versionId_targetId_entitySeeds")
  inverse_seedValues_versionId_seedId SeedValue[] @relation("R_seedValues_versionId_seedId_entitySeeds")
  inverse_seedValues_versionId_refSeedId SeedValue[] @relation("R_seedValues_versionId_refSeedId_entitySeeds")
  inverse_gameEntities_versionId_seedId GameEntity[] @relation("R_gameEntities_versionId_seedId_entitySeeds")

  @@unique([versionId, key], map: "seed_version_key")
  @@unique([versionId, id], map: "seed_version_id")
  // CHECK seed_not_self: implemented in INTEGRITY.sql; Prisma PSL cannot express CHECK.
  @@map("entity_seeds")
  @@schema("bgwq")
}

/// Definition links encode adjacency, directed tracks, membership, and groupings.
model SeedLink {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  versionId String @db.Uuid @map("version_id")
  sourceId String @db.Uuid @map("source_id")
  targetId String @db.Uuid @map("target_id")
  relation String
  ordinal Int @default(0)
  rel_entitySeeds_versionId_sourceId EntitySeed @relation("R_seedLinks_versionId_sourceId_entitySeeds", fields: [versionId, sourceId], references: [versionId, id], onDelete: NoAction, onUpdate: NoAction)
  rel_entitySeeds_versionId_targetId EntitySeed @relation("R_seedLinks_versionId_targetId_entitySeeds", fields: [versionId, targetId], references: [versionId, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([versionId, sourceId, targetId, relation], map: "seed_link_unique")
  @@map("seed_links")
  @@schema("bgwq")
}

/// State fields typed per entity definition, also used for objectives.
model Field {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  versionId String @db.Uuid @map("version_id")
  entityTypeId String @db.Uuid @map("entity_type_id")
  key String
  typeKey String @map("type_key")
  nullable Boolean @default(false)
  rel_entityTypes_versionId_entityTypeId EntityType @relation("R_fields_versionId_entityTypeId_entityTypes", fields: [versionId, entityTypeId], references: [versionId, id], onDelete: NoAction, onUpdate: NoAction)
  inverse_seedValues_versionId_fieldId SeedValue[] @relation("R_seedValues_versionId_fieldId_fields")
  inverse_expressions_versionId_fieldId Expression[] @relation("R_expressions_versionId_fieldId_fields")
  inverse_gameValues_versionId_fieldId GameValue[] @relation("R_gameValues_versionId_fieldId_fields")
  inverse_gameComposites_versionId_fieldId GameComposite[] @relation("R_gameComposites_versionId_fieldId_fields")

  @@unique([entityTypeId, key], map: "field_entity_key")
  @@unique([versionId, id], map: "field_version_id")
  @@map("fields")
  @@schema("bgwq")
}

/// Typed defaults and initial values are stored in columns; no JSONB.
model SeedValue {
  seedId String @db.Uuid @map("seed_id")
  versionId String @db.Uuid @map("version_id")
  fieldId String @db.Uuid @map("field_id")
  kind ValueKind
  bool Boolean? @map("bool_value")
  int BigInt? @map("int_value")
  decimal Decimal? @db.Decimal(65, 30) @map("decimal_value")
  text String? @map("text_value")
  instant DateTime? @db.Timestamptz(6) @map("instant_value")
  refSeedId String? @db.Uuid @map("ref_seed_id")
  refSeat Int? @map("ref_seat")
  rel_entitySeeds_versionId_seedId EntitySeed @relation("R_seedValues_versionId_seedId_entitySeeds", fields: [versionId, seedId], references: [versionId, id], onDelete: NoAction, onUpdate: NoAction)
  rel_fields_versionId_fieldId Field @relation("R_seedValues_versionId_fieldId_fields", fields: [versionId, fieldId], references: [versionId, id], onDelete: NoAction, onUpdate: NoAction)
  rel_entitySeeds_versionId_refSeedId EntitySeed? @relation("R_seedValues_versionId_refSeedId_entitySeeds", fields: [versionId, refSeedId], references: [versionId, id], onDelete: NoAction, onUpdate: NoAction)

  @@id([seedId, fieldId])
  // CHECK seed_value_one_payload: implemented in INTEGRITY.sql; Prisma PSL cannot express CHECK.
  @@map("seed_values")
  @@schema("bgwq")
}

/// Immutable registry metadata; executable operators are implemented only in engine.
model Operator {
  key String @id
  kind String
  returns String?
  summary String
  inverse_operatorParameters_operatorKey OperatorParameter[] @relation("R_operatorParameters_operatorKey_operators")
  inverse_expressions_operatorKey Expression[] @relation("R_expressions_operatorKey_operators")
  inverse_effects_operatorKey Effect[] @relation("R_effects_operatorKey_operators")

  // CHECK operator_kind: implemented in INTEGRITY.sql; Prisma PSL cannot express CHECK.
  @@map("operators")
  @@schema("bgwq")
}

/// operator_parameters persisted application records.
model OperatorParameter {
  operatorKey String @map("operator_key")
  key String
  typeKey String @map("type_key")
  ordinal Int
  required Boolean @default(true)
  variadic Boolean @default(false)
  rel_operators_operatorKey Operator @relation("R_operatorParameters_operatorKey_operators", fields: [operatorKey], references: [key], onDelete: NoAction, onUpdate: NoAction)

  @@id([operatorKey, key])
  @@unique([operatorKey, ordinal], map: "operator_param_order")
  @@map("operator_parameters")
  @@schema("bgwq")
}

/// hooks persisted application records.
model Hook {
  key String @id
  ordinal Int @unique
  summary String
  inverse_actions_hookKey Action[] @relation("R_actions_hookKey_hooks")

  @@map("hooks")
  @@schema("bgwq")
}

/// Acyclic, reusable expression DAG; conditions are bool-valued expressions.
model Expression {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  versionId String @db.Uuid @map("version_id")
  key String?
  kind String
  resultType String @map("result_type")
  literalKind ValueKind? @map("literal_kind")
  literalBool Boolean? @map("literal_bool")
  literalInt BigInt? @map("literal_int")
  literalDecimal Decimal? @db.Decimal(65, 30) @map("literal_decimal")
  literalText String? @map("literal_text")
  literalInstant DateTime? @db.Timestamptz(6) @map("literal_instant")
  referenceKey String? @map("reference_key")
  fieldId String? @db.Uuid @map("field_id")
  operatorKey String? @map("operator_key")
  rel_versions_versionId Version @relation("R_expressions_versionId_versions", fields: [versionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  rel_fields_versionId_fieldId Field? @relation("R_expressions_versionId_fieldId_fields", fields: [versionId, fieldId], references: [versionId, id], onDelete: NoAction, onUpdate: NoAction)
  rel_operators_operatorKey Operator? @relation("R_expressions_operatorKey_operators", fields: [operatorKey], references: [key], onDelete: NoAction, onUpdate: NoAction)
  inverse_expressionArguments_versionId_parentId ExpressionArgument[] @relation("R_expressionArguments_versionId_parentId_expressions")
  inverse_expressionArguments_versionId_childId ExpressionArgument[] @relation("R_expressionArguments_versionId_childId_expressions")
  inverse_actions_versionId_iteratorExpressionId Action[] @relation("R_actions_versionId_iteratorExpressionId_expressions")
  inverse_actions_versionId_conditionExpressionId Action[] @relation("R_actions_versionId_conditionExpressionId_expressions")
  inverse_effects_versionId_conditionExpressionId Effect[] @relation("R_effects_versionId_conditionExpressionId_expressions")
  inverse_effectArguments_versionId_expressionId EffectArgument[] @relation("R_effectArguments_versionId_expressionId_expressions")

  @@unique([versionId, id], map: "expr_version_id")
  @@unique([versionId, key], map: "expr_version_key")
  // CHECK expression_kind: implemented in INTEGRITY.sql; Prisma PSL cannot express CHECK.
  @@map("expressions")
  @@schema("bgwq")
}

/// expression_arguments persisted application records.
model ExpressionArgument {
  versionId String @db.Uuid @map("version_id")
  parentId String @db.Uuid @map("parent_id")
  childId String @db.Uuid @map("child_id")
  parameter String
  ordinal Int @default(0)
  rel_expressions_versionId_parentId Expression @relation("R_expressionArguments_versionId_parentId_expressions", fields: [versionId, parentId], references: [versionId, id], onDelete: NoAction, onUpdate: NoAction)
  rel_expressions_versionId_childId Expression @relation("R_expressionArguments_versionId_childId_expressions", fields: [versionId, childId], references: [versionId, id], onDelete: NoAction, onUpdate: NoAction)

  @@id([parentId, parameter, ordinal])
  // CHECK expression_not_self: implemented in INTEGRITY.sql; Prisma PSL cannot express CHECK.
  @@map("expression_arguments")
  @@schema("bgwq")
}

/// Manual commands and automatic hook actions share one implementation.
model Action {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  versionId String @db.Uuid @map("version_id")
  entityTypeId String @db.Uuid @map("entity_type_id")
  key String
  title String
  trigger TriggerKind
  hookKey String? @map("hook_key")
  iteratorExpressionId String? @db.Uuid @map("iterator_expression_id")
  iteratorVar String? @map("iterator_var")
  conditionExpressionId String? @db.Uuid @map("condition_expression_id")
  priority Int @default(0)
  enabled Boolean @default(true)
  rel_entityTypes_versionId_entityTypeId EntityType @relation("R_actions_versionId_entityTypeId_entityTypes", fields: [versionId, entityTypeId], references: [versionId, id], onDelete: NoAction, onUpdate: NoAction)
  rel_expressions_versionId_iteratorExpressionId Expression? @relation("R_actions_versionId_iteratorExpressionId_expressions", fields: [versionId, iteratorExpressionId], references: [versionId, id], onDelete: NoAction, onUpdate: NoAction)
  rel_expressions_versionId_conditionExpressionId Expression? @relation("R_actions_versionId_conditionExpressionId_expressions", fields: [versionId, conditionExpressionId], references: [versionId, id], onDelete: NoAction, onUpdate: NoAction)
  rel_hooks_hookKey Hook? @relation("R_actions_hookKey_hooks", fields: [hookKey], references: [key], onDelete: NoAction, onUpdate: NoAction)
  inverse_actionParameters_versionId_actionId ActionParameter[] @relation("R_actionParameters_versionId_actionId_actions")
  inverse_phaseActions_versionId_actionId PhaseAction[] @relation("R_phaseActions_versionId_actionId_actions")
  inverse_effects_versionId_actionId Effect[] @relation("R_effects_versionId_actionId_actions")

  @@unique([entityTypeId, key], map: "action_owner_key")
  @@unique([versionId, id], map: "action_version_id")
  @@index([trigger, hookKey, priority], map: "action_hook_order")
  // CHECK action_trigger_check: implemented in INTEGRITY.sql; Prisma PSL cannot express CHECK.
  // CHECK action_iterator_pair: implemented in INTEGRITY.sql; Prisma PSL cannot express CHECK.
  @@map("actions")
  @@schema("bgwq")
}

/// action_parameters persisted application records.
model ActionParameter {
  versionId String @db.Uuid @map("version_id")
  actionId String @db.Uuid @map("action_id")
  key String
  typeKey String @map("type_key")
  required Boolean @default(true)
  ordinal Int @default(0)
  rel_actions_versionId_actionId Action @relation("R_actionParameters_versionId_actionId_actions", fields: [versionId, actionId], references: [versionId, id], onDelete: NoAction, onUpdate: NoAction)

  @@id([actionId, key])
  @@map("action_parameters")
  @@schema("bgwq")
}

/// phase_actions persisted application records.
model PhaseAction {
  versionId String @db.Uuid @map("version_id")
  phaseId String @db.Uuid @map("phase_id")
  actionId String @db.Uuid @map("action_id")
  rel_phases_versionId_phaseId Phase @relation("R_phaseActions_versionId_phaseId_phases", fields: [versionId, phaseId], references: [versionId, id], onDelete: NoAction, onUpdate: NoAction)
  rel_actions_versionId_actionId Action @relation("R_phaseActions_versionId_actionId_actions", fields: [versionId, actionId], references: [versionId, id], onDelete: NoAction, onUpdate: NoAction)

  @@id([phaseId, actionId])
  @@map("phase_actions")
  @@schema("bgwq")
}

/// Effects of any action are ordered, typed, and executed only on proposed state.
model Effect {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  versionId String @db.Uuid @map("version_id")
  actionId String @db.Uuid @map("action_id")
  ordinal Int
  operatorKey String @map("operator_key")
  conditionExpressionId String? @db.Uuid @map("condition_expression_id")
  rel_actions_versionId_actionId Action @relation("R_effects_versionId_actionId_actions", fields: [versionId, actionId], references: [versionId, id], onDelete: NoAction, onUpdate: NoAction)
  rel_expressions_versionId_conditionExpressionId Expression? @relation("R_effects_versionId_conditionExpressionId_expressions", fields: [versionId, conditionExpressionId], references: [versionId, id], onDelete: NoAction, onUpdate: NoAction)
  rel_operators_operatorKey Operator @relation("R_effects_operatorKey_operators", fields: [operatorKey], references: [key], onDelete: NoAction, onUpdate: NoAction)
  inverse_effectArguments_versionId_effectId EffectArgument[] @relation("R_effectArguments_versionId_effectId_effects")

  @@unique([versionId, id], map: "effect_version_id")
  @@unique([actionId, ordinal], map: "effect_action_order")
  @@map("effects")
  @@schema("bgwq")
}

/// effect_arguments persisted application records.
model EffectArgument {
  versionId String @db.Uuid @map("version_id")
  effectId String @db.Uuid @map("effect_id")
  expressionId String @db.Uuid @map("expression_id")
  key String
  ordinal Int @default(0)
  rel_effects_versionId_effectId Effect @relation("R_effectArguments_versionId_effectId_effects", fields: [versionId, effectId], references: [versionId, id], onDelete: NoAction, onUpdate: NoAction)
  rel_expressions_versionId_expressionId Expression @relation("R_effectArguments_versionId_expressionId_expressions", fields: [versionId, expressionId], references: [versionId, id], onDelete: NoAction, onUpdate: NoAction)

  @@id([effectId, key, ordinal])
  @@map("effect_arguments")
  @@schema("bgwq")
}

/// Binary assets live in Supabase Storage, never in configuration rows.
model Asset {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  versionId String @db.Uuid @map("version_id")
  key String
  bucket String
  path String
  mime String
  bytes BigInt
  sha256 String
  status AssetStatus @default(staged)
  rel_versions_versionId Version @relation("R_assets_versionId_versions", fields: [versionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  inverse_visualPrimitives_versionId_assetId VisualPrimitive[] @relation("R_visualPrimitives_versionId_assetId_assets")

  @@unique([versionId, key], map: "asset_version_key")
  @@unique([versionId, id], map: "asset_version_id")
  @@unique([bucket, path], map: "asset_storage_path")
  // CHECK asset_size: implemented in INTEGRITY.sql; Prisma PSL cannot express CHECK.
  // CHECK asset_hash_lower_hex: implemented in INTEGRITY.sql; Prisma PSL cannot express CHECK.
  // CHECK asset_supported_mime: implemented in INTEGRITY.sql; Prisma PSL cannot express CHECK.
  // CHECK asset_path_nonempty: implemented in INTEGRITY.sql; Prisma PSL cannot express CHECK.
  @@map("assets")
  @@schema("bgwq")
}

/// Generic SVG presentation associated with any configured entity type.
model VisualTemplate {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  versionId String @db.Uuid @map("version_id")
  entityTypeId String @db.Uuid @map("entity_type_id")
  key String
  rel_entityTypes_versionId_entityTypeId EntityType @relation("R_visualTemplates_versionId_entityTypeId_entityTypes", fields: [versionId, entityTypeId], references: [versionId, id], onDelete: NoAction, onUpdate: NoAction)
  inverse_visualPrimitives_versionId_templateId VisualPrimitive[] @relation("R_visualPrimitives_versionId_templateId_visualTemplates")

  @@unique([entityTypeId, key], map: "visual_type_key")
  @@unique([versionId, id], map: "visual_template_version_id")
  @@map("visual_templates")
  @@schema("bgwq")
}

/// visual_primitives persisted application records.
model VisualPrimitive {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  versionId String @db.Uuid @map("version_id")
  templateId String @db.Uuid @map("template_id")
  kind String
  layer Int @default(0)
  ordinal Int @default(0)
  x Decimal @default(0) @db.Decimal(65, 30)
  y Decimal @default(0) @db.Decimal(65, 30)
  width Decimal? @db.Decimal(65, 30)
  height Decimal? @db.Decimal(65, 30)
  d String? @map("path_data")
  text String? @map("text_content")
  fill String?
  stroke String?
