{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bgwq:configuration:v1",
  "title": "BoardGamesWithQuests portable configuration v1",
  "description": "Versioned, portable authoring format; database stores its normalized relational projection.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "format_version",
    "definition",
    "roles",
    "phases",
    "entities",
    "seeds",
    "links",
    "fields",
    "actions",
    "visuals",
    "assets"
  ],
  "properties": {
    "format": {
      "const": "bgwq.configuration"
    },
    "format_version": {
      "const": 1
    },
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "name",
        "min_participants",
        "max_participants"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "min_participants": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "max_participants": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "semantics_version": {
          "const": 1
        }
      }
    },
    "roles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/role"
      }
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/phase"
      }
    },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/entity"
      }
    },
    "seeds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/seed"
      }
    },
    "links": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/link"
      }
    },
    "fields": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/field"
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/action"
      }
    },
    "visuals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/visual"
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      }
    }
  },
  "$defs": {
    "key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]*$"
    },
    "role": {
      "type": "object",
      "required": [
        "key",
        "name",
        "min",
        "max"
      ],
      "additionalProperties": false,
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "name": {
          "type": "string"
        },
        "min": {
          "type": "integer",
          "minimum": 0
        },
        "max": {
          "type": "integer",
          "minimum": 0
        },
        "forward_row": {
          "type": [
            "integer",
            "null"
          ],
          "enum": [
            -1,
            1,
            null
          ],
          "description": "Optional forward row orientation used by generic relative-vector operations."
        }
      }
    },
    "phase": {
      "type": "object",
      "required": [
        "key",
        "name",
        "initial",
        "order"
      ],
      "additionalProperties": false,
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "name": {
          "type": "string"
        },
        "initial": {
          "type": "boolean"
        },
        "order": {
          "type": "integer"
        }
      }
    },
    "entity": {
      "type": "object",
      "required": [
        "key",
        "kind",
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "kind": {
          "enum": [
            "game",
            "space",
            "item",
            "objective"
          ]
        },
        "name": {
          "type": "string"
        }
      }
    },
    "seed": {
      "type": "object",
      "required": [
        "key",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "type": {
          "$ref": "#/$defs/key"
        },
        "owner": {
          "type": "integer",
          "minimum": 0
        },
        "parent": {
          "$ref": "#/$defs/key"
        },
        "location": {
          "$ref": "#/$defs/key"
        },
        "order": {
          "type": "integer"
        },
        "row": {
          "type": "integer"
        },
        "column": {
          "type": "integer"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "values": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/value"
          }
        }
      }
    },
    "link": {
      "type": "object",
      "required": [
        "source",
        "target",
        "relation"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "$ref": "#/$defs/key"
        },
        "target": {
          "$ref": "#/$defs/key"
        },
        "relation": {
          "$ref": "#/$defs/key"
        },
        "order": {
          "type": "integer"
        }
      }
    },
    "field": {
      "type": "object",
      "required": [
        "entity",
        "key",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "entity": {
          "$ref": "#/$defs/key"
        },
        "key": {
          "$ref": "#/$defs/key"
        },
        "type": {
          "enum": [
            "bool",
            "int",
            "decimal",
            "text",
            "instant",
            "entity",
            "participant"
          ]
        },
        "nullable": {
          "type": "boolean"
        },
        "default": {
          "$ref": "#/$defs/value"
        }
      }
    },
    "value": {
      "type": [
        "boolean",
        "integer",
        "number",
        "string",
        "null"
      ]
    },
    "expression": {
      "type": "object",
      "required": [
        "op"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "$ref": "#/$defs/key"
        },
        "args": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "$ref": "#/$defs/expression"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/expression"
                }
              }
            ]
          }
        },
        "value": {
          "$ref": "#/$defs/value"
        },
        "ref": {
          "type": "string"
        },
        "type": {
          "type": "string"
        }
      }
    },
    "effect": {
      "type": "object",
      "required": [
        "op"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "$ref": "#/$defs/key"
        },
        "when": {
          "$ref": "#/$defs/expression"
        },
        "args": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "$ref": "#/$defs/expression"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/expression"
                }
              }
            ]
          }
        }
      }
    },
    "action": {
      "type": "object",
      "required": [
        "key",
        "entity",
        "trigger",
        "phase",
        "condition",
        "effects"
      ],
      "additionalProperties": false,
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "entity": {
          "$ref": "#/$defs/key"
        },
        "name": {
          "type": "string"
        },
        "trigger": {
          "enum": [
            "command",
            "hook"
          ]
        },
        "hook": {
          "type": "string"
        },
        "phase": {
          "type": "string"
        },
        "parameters": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "key",
              "type"
            ],
            "additionalProperties": false,
            "properties": {
              "key": {
                "$ref": "#/$defs/key"
              },
              "type": {
                "type": "string"
              },
              "required": {
                "type": "boolean"
              },
              "choices": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "iterator": {
          "$ref": "#/$defs/expression"
        },
        "variable": {
          "type": "string"
        },
        "condition": {
          "$ref": "#/$defs/expression"
        },
        "effects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/effect"
          }
        },
        "priority": {
          "type": "integer"
        }
      }
    },
    "visual": {
      "type": "object",
      "required": [
        "entity",
        "primitives"
      ],
      "additionalProperties": false,
      "properties": {
        "entity": {
          "$ref": "#/$defs/key"
        },
        "primitives": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "kind"
            ],
            "additionalProperties": false,
            "properties": {
              "kind": {
                "enum": [
                  "rectangle",
                  "ellipse",
                  "line",
                  "path",
                  "text",
                  "image"
                ]
              },
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "width": {
                "type": "number"
              },
              "height": {
                "type": "number"
              },
              "fill": {
                "type": "string"
              },
              "stroke": {
                "type": "string"
              },
              "d": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "asset": {
                "type": "string"
              },
              "layer": {
                "type": "integer"
              }
            }
          }
        }
      }
    },
    "asset": {
      "type": "object",
      "required": [
        "key",
        "mime",
        "sha256",
        "base64"
      ],
      "additionalProperties": false,
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "mime": {
          "enum": [
            "image/png",
            "image/webp"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "base64": {
          "type": "string"
        }
      }
    }
  }
}
