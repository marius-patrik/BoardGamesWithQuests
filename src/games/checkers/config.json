    {
      "id": "legal_geometry",
      "hook": "permits_move",
      "when": {
        "op": "true"
      },
      "effects": [
        {
          "op": "permit",
          "params": {}
        }
      ]
    },
    {
      "id": "compulsory_capture",
      "hook": "permits_move",
      "when": {
        "op": "all",
        "args": [
          {
            "op": "compare",
            "left": {
              "query": "capture_count",
              "params": {
                "scope": "maximum"
              }
            },
            "relation": "gt",
            "right": 0
          },
          {
            "op": "compare",
            "left": {
              "query": "capture_count",
              "params": {
                "scope": "candidate"
              }
            },
            "relation": "eq",
            "right": 0
          }
        ]
      },
      "effects": [
        {
          "op": "deny",
          "params": {
            "reason": "A capture is compulsory"
          }
        }
      ]
    },
    {
      "id": "last_move_wins",
      "hook": "outcome",
      "when": {
        "op": "all",
        "args": [
          {
            "op": "compare",
            "relation": "eq",
            "left": {
              "ref": "event.type"
            },
            "right": "move"
          },
          {
            "op": "compare",
            "left": {
              "query": "legal_move_count",
              "params": {
                "side": "active"
              }
            },
            "relation": "eq",
            "right": 0
          }
        ]
      },
      "effects": [
        {
          "op": "propose_outcome",
          "params": {
            "kind": "win",
            "cause": "no_legal_moves",
            "winner": {
              "query": "json_value",
              "params": {
                "value": {
                  "query": "participant",
                  "params": {
                    "side": "opponent"
                  }
                },
                "path": [
                  "id"
                ]
              }
            },
            "priority": 100
          }
        }
      ]
    },
    {
      "id": "resignation",
      "hook": "outcome",
      "when": {
        "op": "compare",
        "relation": "eq",
        "left": {
          "ref": "event.type"
        },
        "right": "resign"
      },
      "effects": [
        {
          "op": "propose_outcome",
          "params": {
            "kind": "win",
            "cause": "resignation",
            "winner": {
              "ref": "player.opponent.id"
            },
            "priority": 80
          }
        }
      ]
    },
    {
      "id": "timeout",
      "hook": "outcome",
      "when": {
        "op": "compare",
        "relation": "eq",
        "left": {
          "ref": "event.type"
        },
        "right": "timeout"
      },
      "effects": [
        {
          "op": "propose_outcome",
          "params": {
            "kind": "win",
            "cause": "timeout",
            "winner": {
              "ref": "player.opponent.id"
            },
            "priority": 80
          }
        }
      ]
    }
  ],
  "quests": [
    {
